# ─────────────────────────────────────────────────────────────────────────────
# NR Property · environment variables
# Copy to `.env` for local development. Never commit real values.
# Settings a client may change (phone, Pixel ID, colours…) live in the admin, not here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Public URL of the site, no trailing slash. Used for canonical URLs, sitemaps and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 on staging to keep the site out of Google (Vercel previews are blocked automatically).
SITE_NOINDEX=

# Postgres connection string. Neon: use the pooled connection string with ?sslmode=require.
DATABASE_URL=postgres://nr:nr@localhost:5432/nrproperty

# Long random string that signs admin sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# 1 = don't run database migrations during a local `next build` (see README, Changing the database schema).
SKIP_PROD_MIGRATIONS=

# Shows /styleguide in production builds when "true" (it is always on in development).
ENABLE_STYLEGUIDE=false

# ── Media storage (Cloudflare R2 / any S3-compatible bucket) ─────────────────
# Leave S3_BUCKET empty to store uploads on local disk (./media), e.g. in development.
S3_BUCKET=
# R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Comma-separated hostnames next/image may load from (e.g. your R2 public bucket domain).
NEXT_PUBLIC_IMAGE_HOSTS=

# ── Email (lead notifications) — Phase 4 ─────────────────────────────────────
# "resend" or "smtp"
EMAIL_PROVIDER=resend
EMAIL_FROM="NR Property <leads@nrproperty.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Google Sheets ("NR Leads") — Phase 4 ─────────────────────────────────────
# Service account that has edit access to the sheet. The sheet ID itself is set in the admin.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Cloudflare Turnstile (spam protection) — Phase 4 ────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Meta Conversions API — Phase 5 ───────────────────────────────────────────
# Pixel ID and test event code are set in the admin (Tracking). The access token is a secret,
# so it can live here instead of the database; if both are set, this one wins.
META_CAPI_ACCESS_TOKEN=

# ── On-demand revalidation — Phase 2 ─────────────────────────────────────────
# Shared secret the CMS uses to tell the site to refresh cached pages.
REVALIDATE_SECRET=change-me

# ── Seed (optional) ──────────────────────────────────────────────────────────
# `pnpm seed` creates this admin user if both are set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
